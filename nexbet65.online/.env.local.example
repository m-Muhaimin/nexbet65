# Aviator game server (default ws://localhost:8080)
# NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Crazy Time game server (default ws://localhost:8090)
# NEXT_PUBLIC_WS_URL_WHEEL=ws://localhost:8090

# Secret used to sign the demo session cookie (change for production)
# AUTH_SECRET=change-me

# Comma-separated player usernames granted super-admin access to /admin.
# ADMIN_USERNAME=admin111
